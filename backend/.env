# Chronicle AI Backend Development Environment

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Chronicle AI"
API_V1_STR=/api/v1

LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chronicle_ai

JWT_SECRET_KEY=insecure_dev_secret_key_change_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
