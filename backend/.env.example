# Chronicle AI Backend Environment Configuration

# Server Environment Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Chronicle AI"
API_V1_STR=/api/v1

# Logging Settings
LOG_LEVEL=INFO

# Database Settings (PostgreSQL + AsyncPG)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chronicle_ai

# Security / Secret Key (Placeholder)
JWT_SECRET_KEY=insecure_dev_secret_key_change_in_prod
