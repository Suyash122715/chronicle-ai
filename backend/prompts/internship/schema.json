{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InternshipLetterExtractionSchema",
  "type": "object",
  "properties": {
    "internship_info": {
      "type": "object",
      "properties": {
        "intern_name": { "type": "string" },
        "organization": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "duration": { "type": "string" },
        "supervisor_name": { "type": "string" },
        "supervisor_designation": { "type": "string" },
        "stipend": { "type": "string" },
        "location": { "type": "string" },
        "letter_type": {
          "type": "string",
          "enum": ["offer_letter", "completion_letter", "experience_letter", "internship_certificate", "unknown"]
        },
        "issue_date": { "type": "string" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "responsibilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "_provenance": { "type": "object" }
  },
  "required": ["internship_info", "_provenance"]
}
